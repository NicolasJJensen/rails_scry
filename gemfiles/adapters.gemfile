# frozen_string_literal: true

source 'https://rubygems.org'
gemspec path: '..'

gem 'activerecord', "~> #{ENV.fetch('RAILS_VERSION', '8.1')}.0"
adapter = ENV.fetch('SCRY_ADAPTER', 'sqlite3')
raise ArgumentError, 'SCRY_ADAPTER must be sqlite3 or mysql2' unless %w[sqlite3 mysql2].include?(adapter)
gem adapter, *(adapter == 'sqlite3' && Gem::Version.new(ENV.fetch('RAILS_VERSION', '8.1')) < Gem::Version.new('8.0') ? ['~> 1.4'] : [])
gem 'rspec', '~> 3.13'
gem 'pundit', '~> 2.5'
gem 'rbs', '~> 3.4', require: false
